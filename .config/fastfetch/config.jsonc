{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "magenta",
      "title": "magenta",
      "user": "magenta",
      "host": "magenta"
    }
  },
  "logo2": {
    "type": "file",
    "source": "~/.config/fastfetch/logo2.txt",
    "position": "left",
    "padding": {
      "top": 3,
      "left": 0,
      "right": 4
    }
  },
  "logo": {
    "type": "sixel",
    "source": "~/Pictures/c30/bepi6_nd.png",
    "width": 42,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 2,
      "bottom": 4
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "title"
    },
    "break",
    {
      "type": "os",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "format": "{1} {#bright_black}({2}){#white}"
    },
    "de",
    {
      "type": "wm",
      "format": "{1} {#bright_black}({5}){#white}"
    },
    {
      "type": "terminal",
      "format": "{1} {#bright_black}{#white}"
    },
    {
      "type": "shell",
      "format": "{1} {#bright_black}({4}){#white}"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "showPeCoreCount": false,
      "temp": false
    },
    {
      "type": "gpu",
      "format": "{vendor} {name}"
    },
    "memory",
    {
      "type": "command",
      "key": "OS Age",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "char=\"✖\"; echo -e \"\\e[0;90m${char} \\e[0;37m  ${char} \\e[0;31m  ${char} \\e[0;33m  ${char} \\e[0;32m  ${char} \\e[0;34m  ${char} \\e[0;36m  ${char} \\e[0;35m  ${char}\\e[0;37m   \""
    },
    "break"
  ]
}
