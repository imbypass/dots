#!/bin/bash
source harmony-color-codes

case "$1" in
    "setup")
        printf "${BOLD}${BLUE}:: ${RESET}Initializing miscellaneous setup files..\n"
        gsettings set org.gnome.desktop.wm.preferences button-layout ":"
    ;;
    "dbus")
        printf "${BOLD}${BLUE}:: ${RESET}Initializing dbus..\n"
        dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
    ;;
    "xdg")
        printf "${BOLD}${BLUE}:: ${RESET}Initializing xdg-desktop-portal..\n"
        sleep 1
        killall xdg-desktop-portal-hyprland > /dev/null 2>&1
        killall xdg-desktop-portal > /dev/null 2>&1
        sleep 1
        /usr/lib/xdg-desktop-portal-hyprland > /dev/null 2>&1 &
        sleep 2
        /usr/lib/xdg-desktop-portal > /dev/null 2>&1 &
        sleep 1
    ;;
    "wp")
        printf "${BOLD}${BLUE}:: ${RESET}Initializing wallpaper daemon..\n"
        killall awww-daemon > /dev/null 2>&1 &
        sleep .5 && awww-daemon --format xrgb &

        sleep 1 && harmony-theme-set-wallpaper HDMI-A-1 $(cat ~/.local/share/wallpapers/.wallpaper_path)
    ;;
    "gnome")
        printf "${BOLD}${BLUE}:: ${RESET}Initializing GNOME settings..\n"
        gsettings set org.gnome.desktop.wm.preferences button-layout ":"
esac
